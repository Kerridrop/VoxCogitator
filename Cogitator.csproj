<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Cogitator</AssemblyName>
    <RootNamespace>Cogitator</RootNamespace>
    <ApplicationIcon>assets/cog.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <Version>1.0.1</Version>
    <NoWarn>CS0414;CS0169;CS0219;CS0162;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Cogitator.cs" />
    <EmbeddedResource Include="assets/fonts/FSEX.ttf" LogicalName="FSEX.ttf" />
    <EmbeddedResource Include="assets/fonts/CogDOS.ttf" LogicalName="CogDOS.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/lib/mono/4.8-api')">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
  </PropertyGroup>
</Project>
