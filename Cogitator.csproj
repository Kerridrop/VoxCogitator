<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Cogitator</AssemblyName>
    <RootNamespace>Cogitator</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <NoWarn>CS0414;CS0169;CS0219;CS0162;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Cogitator.cs" />
    <EmbeddedResource Include="assets/fonts/FSEX.ttf" LogicalName="FSEX.ttf" />
    <EmbeddedResource Include="assets/fonts/CogDOS.ttf" LogicalName="CogDOS.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
  <!-- вне Windows: справочные сборки .NET Framework из Mono -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/lib/mono/4.8-api')">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
  </PropertyGroup>
  <Target Name="DebugRefs" BeforeTargets="CoreCompile">
    <Warning Text="DBG FPO=[$(FrameworkPathOverride)]" />
    <Warning Text="DBG TFRoot=[$(TargetFrameworkRootPath)]" />
    <Warning Text="DBG OS=[$(OS)] NuGetRoot=[$(NuGetPackageRoot)]" />
    <Warning Text="DBG AutoRefPkg=[$(AutomaticallyUseReferenceAssemblyPackages)]" />
  </Target>
</Project>
